# Copiar a .env (no se versiona): Docker Compose toma toda la configuración de aquí.

# --- MongoDB ---
MONGO_USER=bill
MONGO_PASSWORD=123456
MONGO_DB=bill
MONGO_PORT=27017

# --- SMTP (correo real) ---
# Brevo: usar smtp-relay.sendinblue.com; el certificado TLS no incluye smtp-relay.brevo.com
SMTP_HOST=smtp-relay.sendinblue.com
SMTP_PORT=587
SMTP_USERNAME=usuario@smtp-brevo.com
SMTP_PASSWORD=clave-smtp
# Remitente verificado en el proveedor; sin él el correo se acepta pero no se entrega
SMTP_FROM=remitente@dominio.com

# --- Aplicaciones ---
API_PORT=5080
WEB_PORT=5173
# URL de la API que usa la web; requiere reconstruir la imagen web al cambiarla
VITE_API_URL=http://localhost:5080
